# Local-only configuration. Run python scripts/init_env.py to create .env safely.
# No production credentials or personal data belong here.
COMPOSE_PROJECT_NAME=jobhunter-ai
WEB_PORT=5173
API_PORT=8000
JOBHUNTER_DB_HOST=127.0.0.1
JOBHUNTER_DB_PORT=5433
JOBHUNTER_DB_NAME=jobhunter
JOBHUNTER_DB_USER=jobhunter
JOBHUNTER_DB_PASSWORD=
JOBHUNTER_APP_DB_USER=jobhunter_app
JOBHUNTER_APP_DB_PASSWORD=
# Backend only. Import from a local file using scripts/configure_openai.py.
JOBHUNTER_OPENAI_API_KEY=
JOBHUNTER_AI_MODEL=gpt-4.1-mini-2025-04-14
JOBHUNTER_AI_CV_MODEL=gpt-4.1-mini-2025-04-14
JOBHUNTER_AI_PARSING_MODEL=gpt-4.1-mini-2025-04-14
JOBHUNTER_AI_MATCHING_MODEL=gpt-5.6-luna
JOBHUNTER_AI_STRATEGY_MODEL=gpt-4.1-mini-2025-04-14
JOBHUNTER_AI_REVIEW_MODEL=gpt-5.6-luna
JOBHUNTER_AI_RESEARCH_MODEL=gpt-5.6-luna
JOBHUNTER_AI_CV_EFFORT=high
JOBHUNTER_AI_PARSING_EFFORT=high
JOBHUNTER_AI_MATCHING_EFFORT=high
JOBHUNTER_AI_STRATEGY_EFFORT=high
JOBHUNTER_AI_REVIEW_EFFORT=high
JOBHUNTER_AI_RESEARCH_EFFORT=high
# Optional task-specific operator guidance. Included in prompt version and cache hash.
JOBHUNTER_AI_CV_PROMPT_SUFFIX=
JOBHUNTER_AI_PARSING_PROMPT_SUFFIX=
JOBHUNTER_AI_MATCHING_PROMPT_SUFFIX=
JOBHUNTER_AI_STRATEGY_PROMPT_SUFFIX=
JOBHUNTER_AI_REVIEW_PROMPT_SUFFIX=
JOBHUNTER_AI_RESEARCH_PROMPT_SUFFIX=
JOBHUNTER_AI_MAX_OUTPUT_TOKENS=8000
JOBHUNTER_AI_TIMEOUT_SECONDS=180
JOBHUNTER_AI_MONTHLY_EUR=10
JOBHUNTER_COMBINED_MONTHLY_EUR=25
JOBHUNTER_AI_EUR_PER_USD=1.25
JOBHUNTER_AI_PRICES_REVIEWED=2026-09-20
