{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateBoundedSessionRoles",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/jobhunter-p5-*",
      "Condition": {"StringEquals": {"iam:PermissionsBoundary": "arn:aws:iam::aws:policy/PowerUserAccess"}}
    },
    {
      "Sid": "ManageOnlySessionRoles",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:DeleteRole", "iam:TagRole", "iam:UntagRole", "iam:UpdateAssumeRolePolicy", "iam:GetRolePolicy", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies", "iam:ListInstanceProfilesForRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/jobhunter-p5-*"
    },
    {
      "Sid": "AttachOnlySSMCore",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/jobhunter-p5-*",
      "Condition": {"ArnEquals": {"iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"}}
    },
    {
      "Sid": "ManageOnlySessionInstanceProfiles",
      "Effect": "Allow",
      "Action": ["iam:CreateInstanceProfile", "iam:GetInstanceProfile", "iam:DeleteInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile", "iam:TagInstanceProfile", "iam:UntagInstanceProfile"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:instance-profile/jobhunter-p5-*"
    },
    {
      "Sid": "PassSessionRolesOnlyToRequiredServices",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/jobhunter-p5-*",
      "Condition": {"StringEquals": {"iam:PassedToService": ["ec2.amazonaws.com", "scheduler.amazonaws.com"]}}
    }
  ]
}
